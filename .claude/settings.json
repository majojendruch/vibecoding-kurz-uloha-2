{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Agent",
      "WebFetch",
      "Bash(curl:*)",
      "Bash(node .claude/skills/:*)",
      "Bash(wp option get:*)",
      "Bash(wp doctor check:*)",
      "Bash(wp profile:*)",
      "Bash(wp cron event list:*)",
      "Bash(wp plugin list:*)",
      "mcp__lighthouse",
      "mcp__playwright"
    ],
    "ask": [
      "Write",
      "Edit",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./**/wp-config.php)",
      "Read(./**/.env)",
      "Read(./**/*.sql)"
    ]
  }
}
